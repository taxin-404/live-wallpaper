#!/usr/bin/env bash
# omarchy-live-wallpaper — control mpvpaper live video wallpapers.
#
# Usage:
#   omarchy-live-wallpaper set <video>   start a video as the live wallpaper
#   omarchy-live-wallpaper stop          stop the live wallpaper (static shows)
#   omarchy-live-wallpaper restore       restart the saved live wallpaper if any
#   omarchy-live-wallpaper status        print the current live video or "none"
set -euo pipefail

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/live-wallpaper"
BIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LIVE_LINK="$STATE_DIR/current"
MPV_OPTS="no-audio --loop --hwdec=auto-copy"

mkdir -p "$STATE_DIR"

is_active() {
  [[ -L $LIVE_LINK && -f "$(readlink -f "$LIVE_LINK" 2>/dev/null)" ]]
}

is_video() {
  local ext
  [[ -n $1 && -f $1 ]] || return 1
  ext="${1##*.}"
  case "${ext,,}" in
    mp4|mkv|webm|mov|avi|m4v|gif|apng) return 0 ;;
  esac
  return 1
}

# mpvpaper can ignore SIGTERM when its video failed to open (its cleanup
# handler hangs on a dead mpv), so fall back to SIGKILL if it won't die.
kill_mpvpaper() {
  pkill -x mpvpaper 2>/dev/null || true
  for _ in {1..10}; do
    pgrep -x mpvpaper >/dev/null 2>&1 || return 0
    sleep 0.1
  done
  pkill -9 -x mpvpaper 2>/dev/null || true
}

# Wait until mpvpaper's layer has committed with real content on screen.
wait_for_mpvpaper() {
  local timeout=${1:-8} grace=${2:-0.4}
  local end=$((SECONDS + timeout))
  while (( SECONDS < end )); do
    if hyprctl layers -j 2>/dev/null | jq -e \
      'to_entries[] | .value.levels | to_entries[] | .value[] |
       select(.namespace == "mpvpaper" and .w > 0 and .h > 0)' \
      >/dev/null 2>&1; then
      sleep "$grace"
      return 0
    fi
    sleep 0.1
  done
  return 1
}

case "${1:-}" in
  set)
    video="${2:-}"
    [[ -n $video && -f $video ]] || { echo "not a file: ${video:-<none>}" >&2; exit 1; }
    is_video "$video" || { echo "not a video file: $video" >&2; exit 1; }

    # mpvpaper (AUR) + ffmpeg + jq are required. If any are missing this opens
    # a floating terminal that installs them (user types their sudo password)
    # and waits for it to finish before starting the video.
    "$BIN_DIR/omarchy-live-deps" || exit 1
    video=$(realpath "$video")

    # Switching live -> live: just swap the process. The theme wallpaper
    # always sits behind the video, so there is never a blackout gap.
    if pgrep -x mpvpaper >/dev/null 2>&1; then
      kill_mpvpaper
    fi

    ln -nsf "$video" "$LIVE_LINK"

    # Run on the bottom layer: above the theme wallpaper, below the bar and
    # windows. Theme changes only swap the static behind the video, so they
    # never disturb the live wallpaper.
    nohup mpvpaper --auto-pause -l bottom -o "$MPV_OPTS" '*' "$video" >/dev/null 2>&1 &

    if ! wait_for_mpvpaper; then
      kill_mpvpaper
      rm -f "$LIVE_LINK"
      echo "live wallpaper failed to start: $video" >&2
      exit 1
    fi

    echo "live wallpaper: $video"
    ;;
  stop)
    kill_mpvpaper
    rm -f "$LIVE_LINK"
    echo "live wallpaper stopped"
    ;;
  restore)
    is_active || exit 0
    exec "$0" set "$(readlink -f "$LIVE_LINK")"
    ;;
  status)
    if is_active; then
      echo "$(readlink -f "$LIVE_LINK")"
    else
      echo "none"
    fi
    ;;
  *)
    echo "usage: omarchy-live-wallpaper {set <video>|stop|restore|status}" >&2
    exit 1
    ;;
esac
