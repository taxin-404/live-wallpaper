#!/usr/bin/env bash
# omarchy-live-wallpaper — control mpvpaper live video wallpapers.
#
# Usage:
#   omarchy-live-wallpaper set <video>   start a video as the live wallpaper
#   omarchy-live-wallpaper stop          stop the live wallpaper (static shows)
#   omarchy-live-wallpaper restore       restart the saved live wallpaper if any
#   omarchy-live-wallpaper status        print the current live video or "none"
set -euo pipefail

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/live-wallpaper"
BIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LIVE_LINK="$STATE_DIR/current"
IPC_SOCKET="$STATE_DIR/mpv.sock"
HWDEC="${OMARCHY_LIVE_HWDEC:-auto-copy}"
MPV_OPTS="no-audio --loop --hwdec=$HWDEC --framedrop=vo --video-sync=display"
AUTO_MODE="${OMARCHY_LIVE_AUTO_MODE:-FULL}"
LOCK_DIR="$STATE_DIR/.set-lock"
DEPS_OK="$STATE_DIR/.deps-ok"
DEPS_OK_MAX_AGE=300

mkdir -p "$STATE_DIR"

# Serialize set/stop. An mkdir-based lock is atomic and carries no file
# descriptor, so the nohup'd mpvpaper child can never keep holding it after a
# command exits (a flock fd inherited across fork would do exactly that). A
# set that dies hard (SIGKILL) leaves the directory; a stale guard reclaims it.
# Uses the global LOCK_DIR directly: the EXIT trap runs after any `local` here
# has gone out of scope, and an unset reference would abort under `set -u`.
lock_acquire() {
  while ! mkdir "$LOCK_DIR" 2>/dev/null; do
    if [[ -d $LOCK_DIR ]] \
        && (( $(date +%s) - $(stat -c %Y "$LOCK_DIR" 2>/dev/null || echo 0) > 120 )); then
      rmdir "$LOCK_DIR" 2>/dev/null || true
      continue
    fi
    sleep 0.05
  done
  trap 'rmdir "$LOCK_DIR" 2>/dev/null || true' EXIT
}

# Send one JSON IPC command to the running mpv and print its reply. -T 2 bounds
# the whole exchange so a stuck mpv or a lingering open connection can never
# block a `set` indefinitely (mpv normally closes the socket after the reply).
mpv_cmd() {
  [[ -S $IPC_SOCKET ]] || return 1
  printf '%s\n' "$1" | socat -T 2 - "UNIX-CONNECT:$IPC_SOCKET" 2>/dev/null || return 1
}

is_active() {
  [[ -L $LIVE_LINK && -f "$(readlink -f "$LIVE_LINK" 2>/dev/null)" ]]
}

is_video() {
  local ext
  [[ -n $1 && -f $1 ]] || return 1
  ext="${1##*.}"
  case "${ext,,}" in
    mp4|mkv|webm|mov|avi|m4v|gif|apng) return 0 ;;
  esac
  return 1
}

# True when the dependency check passed recently (same boot, under
# DEPS_OK_MAX_AGE). Lets set/restore skip the deps subprocess entirely; a stale
# or missing marker falls through to the real check.
deps_fresh() {
  local boot now
  [[ -f $DEPS_OK ]] || return 1
  boot=$(head -n1 "$DEPS_OK" 2>/dev/null || true)
  [[ -n $boot && $boot == "$(cat /proc/sys/kernel/random/boot_id 2>/dev/null || true)" ]] || return 1
  now=$(date +%s)
  (( now - $(stat -c %Y "$DEPS_OK" 2>/dev/null || echo 0) < DEPS_OK_MAX_AGE ))
}

# mpvpaper can ignore SIGTERM when its video failed to open (its cleanup
# handler hangs on a dead mpv), so fall back to SIGKILL if it won't die.
kill_mpvpaper() {
  pkill -x mpvpaper 2>/dev/null || true
  for _ in {1..10}; do
    pgrep -x mpvpaper >/dev/null 2>&1 || return 0
    sleep 0.1
  done
  pkill -9 -x mpvpaper 2>/dev/null || true
}

# Wait until mpvpaper's layer has committed with real content on screen.
# When a pid is given, only that instance counts — so starting a new video
# over an old one can wait for the new layer instead of the old one. The
# generous default gives a slow first decode (large file, cold disk) room
# before a false "failed to start".
wait_for_mpvpaper() {
  local pid=${1:-0} timeout=${2:-15} grace=${3:-0.1}
  local end=$((SECONDS + timeout))
  while (( SECONDS < end )); do
    if hyprctl layers -j 2>/dev/null | jq -e --argjson p "$pid" \
      'to_entries[] | .value.levels | to_entries[] | .value[] |
       select(.namespace == "mpvpaper" and .w > 0 and .h > 0 and ($p == 0 or .pid == $p))' \
      >/dev/null 2>&1; then
      sleep "$grace"
      return 0
    fi
    sleep 0.1
  done
  return 1
}

# Kill a specific mpvpaper pid, falling back to SIGKILL if it won't die.
kill_mpvpaper_pid() {
  local pid="$1"
  [[ -n $pid ]] || return 0
  kill "$pid" 2>/dev/null || return 0
  for _ in {1..10}; do
    kill -0 "$pid" 2>/dev/null || return 0
    sleep 0.1
  done
  kill -9 "$pid" 2>/dev/null || true
}

# Swap the video inside the running mpvpaper through its mpv IPC socket. The
# layer surface keeps its last presented frame while the new video decodes,
# so live->live switches are seamless: no new process, no gap, no flicker.
ipc_loadfile() {
  local video="$1" reply
  reply=$(mpv_cmd "{\"command\":[\"loadfile\",$(jq -nc --arg v "$video" '$v')]}") || return 1
  [[ $reply == *'"error":"success"'* ]]
}

case "${1:-}" in
  set)
    # Serialize set/stop so a picker racing a menu pick (or a stop) can never
    # start two video layers at once. `omarchy-live-deps` locks a different
    # resource, and nothing holding that lock ever calls `set`, so no deadlock.
    lock_acquire "$LOCK_DIR"

    video="${2:-}"
    [[ -n $video && -f $video ]] || { echo "not a file: ${video:-<none>}" >&2; exit 1; }
    is_video "$video" || { echo "not a video file: $video" >&2; exit 1; }

    # mpvpaper (AUR) + ffmpeg + jq are required. If any are missing this opens
    # a floating terminal that installs them (user types their sudo password)
    # and waits for it to finish before starting the video.
    if ! deps_fresh; then
      "$BIN_DIR/omarchy-live-deps" || exit 1
    elif [[ ${OMARCHY_LIVE_DEBUG:-} == 1 ]]; then
      echo "live wallpaper: deps ok (cached)" >&2
    fi
    video=$(realpath "$video")

    # Switching live -> live: swap inside the running mpvpaper via its IPC
    # socket. The surface keeps its last frame while the new video decodes,
    # so the old video is simply replaced — no static, no gap, no flicker.
    if ipc_loadfile "$video"; then
      ln -nsf "$video" "$LIVE_LINK"
      echo "live wallpaper: $video"
      exit 0
    fi

    # Fresh start (first use, or the socket is stale). Start over any old
    # socketless instance so the theme wallpaper never shows mid-swap.
    old_video=""
    if pgrep -x mpvpaper >/dev/null 2>&1; then
      old_video=$(readlink -f "$LIVE_LINK" 2>/dev/null || true)
    fi

    rm -f "$IPC_SOCKET"
    ln -nsf "$video" "$LIVE_LINK"

    # Run on the bottom layer: above the theme wallpaper, below the bar and
    # windows. Theme changes only swap the static behind the video, so they
    # never disturb the live wallpaper. The ipc-server option lives inside the
    # -o string, so a state path containing whitespace would split it — fall
    # back to fresh-start-only (still works, just no in-place swap) in that
    # rare case.
    ipc_opt=""
    if [[ $IPC_SOCKET == *[[:space:]]* ]]; then
      echo "live wallpaper: state path contains spaces; in-place switching disabled" >&2
    else
      ipc_opt=" --input-ipc-server=$IPC_SOCKET"
    fi
    mpvpaper_args=(--auto-pause)
    case "${AUTO_MODE}" in
      FULL|MAX) mpvpaper_args+=(--auto-mode "$AUTO_MODE") ;;
      none) ;;
      *) echo "live wallpaper: ignoring OMARCHY_LIVE_AUTO_MODE=${AUTO_MODE:-<empty>}" >&2 ;;
    esac
    mpvpaper_args+=(-l bottom -o "$MPV_OPTS$ipc_opt" '*' "$video")
    nohup mpvpaper "${mpvpaper_args[@]}" >/dev/null 2>&1 &
    new_pid=$!

    if ! wait_for_mpvpaper "$new_pid"; then
      kill_mpvpaper_pid "$new_pid"
      if [[ -n $old_video && -f $old_video ]]; then
        ln -nsf "$old_video" "$LIVE_LINK"
      else
        rm -f "$LIVE_LINK"
      fi
      echo "live wallpaper failed to start: $video" >&2
      exit 1
    fi

    # Any previous instance is now redundant.
    old_pids=$(pgrep -x mpvpaper | grep -vx "$new_pid" || true)
    if [[ -n $old_pids ]]; then
      kill $old_pids 2>/dev/null || true
      for _ in {1..10}; do
        remaining=$(pgrep -x mpvpaper | grep -vx "$new_pid" || true)
        [[ -z $remaining ]] && break
        sleep 0.1
      done
      remaining=$(pgrep -x mpvpaper | grep -vx "$new_pid" || true)
      [[ -n $remaining ]] && kill -9 $remaining 2>/dev/null || true
    fi

    echo "live wallpaper: $video"
    ;;
  stop)
    lock_acquire "$LOCK_DIR"
    kill_mpvpaper
    rm -f "$LIVE_LINK" "$IPC_SOCKET"
    echo "live wallpaper stopped"
    ;;
  restore)
    is_active || exit 0
    exec "$0" set "$(readlink -f "$LIVE_LINK")"
    ;;
  status)
    # Report what mpv is actually rendering, not just what the link says, so a
    # crashed renderer doesn't masquerade as a running live wallpaper.
    if is_active; then
      playing=""
      if [[ -S $IPC_SOCKET ]]; then
        playing=$(mpv_cmd '{"command":["get_property","path"]}' \
          | jq -r '.data // empty' 2>/dev/null) || true
      fi
      if [[ -n $playing && -f $playing ]]; then
        echo "$playing"
      else
        echo "none"
      fi
    else
      echo "none"
    fi
    ;;
  *)
    echo "usage: omarchy-live-wallpaper {set <video>|stop|restore|status}" >&2
    exit 1
    ;;
esac
