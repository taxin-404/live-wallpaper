#!/usr/bin/env bash
# omarchy-live-install — one-time, idempotent integration setup for the
# taxin.live-wallpaper plugin. Runs from Service.qml on every shell startup
# but only writes anything the first time (or after the plugin moves).
#
#   - adds the `style.background` menu override (absolute paths + a `when:`
#     guard so the row auto-hides once this plugin is removed)
#   - ensures the system dependencies (mpvpaper, ffmpeg, jq, socat) on every load
#   - removes any leftover theme-set hook from older installs (theme changes
#     no longer need one: the video runs above the theme wallpaper)
#
# Everything stays in user space (~/.config, ~/.local, ~/.cache).
set -euo pipefail

PLUGIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/live-wallpaper"
INSTALLED_FILE="$STATE_DIR/installed"
MENU_EXT="$HOME/.config/omarchy/extensions/omarchy-menu.jsonc"
HOOK_PATH="$HOME/.config/omarchy/hooks/theme-set.d/10-live-wallpaper.sh"

# ------------------------------------------------- system dependencies

# Ensure mpvpaper (AUR), ffmpeg, jq and socat on every load. This is cheap when
# they are present; it only opens an install terminal when something is actually
# missing — so a single `omarchy plugin add ... --enable` (or any shell load
# with a missing dep) self-heals. `set` re-checks too.
"$PLUGIN_DIR/bin/omarchy-live-deps" || true

# ------------------------------ wallpaper double-click entry shims
#
# The desktop double-click (shell plugin background/Background.qml) calls the
# stock `omarchy-theme-bg-switcher` / `omarchy-theme-bg-set` by bare name from
# a `bash -c`. Shadow those two commands with user-space wrappers that delegate
# to the live-capable picker and setter, so every wallpaper entry point
# (menu, launcher, double-click) can select live wallpapers. A ~/.config/uwsm
# env.d drop-in puts the shim directory first in the session PATH; it only
# takes effect after the next session start. Recreated on every load so a
# deleted shim or drop-in self-heals.
SHIM_DIR="$HOME/.local/bin/omarchy-live-shims"
mkdir -p "$SHIM_DIR"
printf '%s\n' \
  '#!/usr/bin/env bash' \
  '# user-space shim -> live-capable picker (managed by taxin.live-wallpaper)' \
  "script=\"$PLUGIN_DIR/bin/omarchy-bg-switcher\"" \
  'if [[ -x $script ]]; then' \
  '  exec "$script" "$@"' \
  'fi' \
  '# Plugin folder gone (partial uninstall): fall back to the stock picker.' \
  'exec /usr/bin/omarchy-theme-bg-switcher "$@"' \
  > "$SHIM_DIR/omarchy-theme-bg-switcher"
printf '%s\n' \
  '#!/usr/bin/env bash' \
  '# user-space shim -> live/static setter (managed by taxin.live-wallpaper)' \
  "script=\"$PLUGIN_DIR/bin/omarchy-bg-set\"" \
  'if [[ -x $script ]]; then' \
  '  exec "$script" "$@"' \
  'fi' \
  '# Plugin folder gone (partial uninstall): fall back to the stock setter.' \
  'exec /usr/bin/omarchy-theme-bg-set "$@"' \
  > "$SHIM_DIR/omarchy-theme-bg-set"
chmod +x "$SHIM_DIR/omarchy-theme-bg-switcher" "$SHIM_DIR/omarchy-theme-bg-set"

ENV_DIR="$HOME/.config/uwsm/env.d"
ENV_FILE="$ENV_DIR/99-live-wallpaper"
mkdir -p "$ENV_DIR"
printf '%s\n' \
  '# taxin.live-wallpaper: put the live wallpaper shims first so the desktop' \
  '# double-click uses the live-capable background picker. Removed on uninstall.' \
  'case ":$PATH:" in' \
  '  *":$HOME/.local/bin/omarchy-live-shims:"*) ;;' \
  '  *) PATH="$HOME/.local/bin/omarchy-live-shims${PATH:+:$PATH}" ;;' \
  'esac' \
  > "$ENV_FILE"

# Already installed for this exact plugin location and generation.
INSTALLED_V2="${PLUGIN_DIR}"$'\n'"v2"
if [[ -f $INSTALLED_FILE ]] && [[ "$(cat "$INSTALLED_FILE" 2>/dev/null || true)" == "$INSTALLED_V2" ]]; then
  exit 0
fi

mkdir -p "$STATE_DIR"

# ------------------------------------------------------------------ menu row

mkdir -p "$(dirname "$MENU_EXT")"
if [[ ! -f $MENU_EXT ]]; then
  printf '{\n}\n' > "$MENU_EXT"
fi

# Remove any previous live-wallpaper block and any bare style.background
# override (migrates installs done by the old install.sh).
sed -i '/\/\/ omarchy-live-wallpaper-menu-start/,/\/\/ omarchy-live-wallpaper-menu-end/d' "$MENU_EXT"
sed -i '/"style\.background":/d' "$MENU_EXT"

MENU_BLOCK='  // omarchy-live-wallpaper-menu-start
  "style.background": {"icon":"","label":"Background","aliases":["background","wallpaper"],"when":"[ -x \"'$PLUGIN_DIR'/bin/omarchy-bg-switcher\" ]","action":"background=\"$('"$PLUGIN_DIR"'/bin/omarchy-bg-switcher)\"; [[ -n $background ]] && \"'$PLUGIN_DIR'/bin/omarchy-bg-set\" \"$background\""}
  // omarchy-live-wallpaper-menu-end'

python3 - "$MENU_EXT" "$MENU_BLOCK" <<'PY'
import sys

path, block = sys.argv[1], sys.argv[2]
with open(path) as f:
    content = f.read()

stripped = content.rstrip()
idx = stripped.rfind('}')
if idx == -1:
    sys.exit(f"no closing brace in {path}")

before = stripped[:idx].rstrip()
after = stripped[idx:].lstrip('\n')
with open(path, "w") as f:
    f.write(before + "\n" + block + "\n" + after)
PY

# ----------------------------------------- stale theme-set hook cleanup

# Older generations installed a theme-set hook to restart the video after a
# theme change. The video now runs on the bottom layer above the theme
# wallpaper, so theme changes can't touch it and the hook is obsolete.
if [[ -f $HOOK_PATH ]]; then
  rm -f -- "$HOOK_PATH"
fi

printf '%s\n' "$INSTALLED_V2" > "$INSTALLED_FILE"

echo "taxin.live-wallpaper: integration installed (menu row; dependencies ensured)"
