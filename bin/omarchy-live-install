#!/usr/bin/env bash
# omarchy-live-install — one-time, idempotent integration setup for the
# taxin.live-wallpaper plugin. Runs from Service.qml on every shell startup
# but only writes anything the first time (or after the plugin moves).
#
#   - adds the `style.background` menu override (absolute paths + a `when:`
#     guard so the row auto-hides once this plugin is removed)
#   - removes any leftover theme-set hook from older installs (theme changes
#     no longer need one: the video runs above the theme wallpaper)
#
# Everything stays in user space (~/.config, ~/.local, ~/.cache).
set -euo pipefail

PLUGIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/live-wallpaper"
INSTALLED_FILE="$STATE_DIR/installed"
MENU_EXT="$HOME/.config/omarchy/extensions/omarchy-menu.jsonc"
HOOK_PATH="$HOME/.config/omarchy/hooks/theme-set.d/10-live-wallpaper.sh"

# Already installed for this exact plugin location and generation.
INSTALLED_V2="${PLUGIN_DIR}"$'\n'"v2"
if [[ -f $INSTALLED_FILE ]] && [[ "$(cat "$INSTALLED_FILE" 2>/dev/null || true)" == "$INSTALLED_V2" ]]; then
  exit 0
fi

mkdir -p "$STATE_DIR"

# ------------------------------------------------------------------ menu row

mkdir -p "$(dirname "$MENU_EXT")"
if [[ ! -f $MENU_EXT ]]; then
  printf '{\n}\n' > "$MENU_EXT"
fi

# Remove any previous live-wallpaper block and any bare style.background
# override (migrates installs done by the old install.sh).
sed -i '/\/\/ omarchy-live-wallpaper-menu-start/,/\/\/ omarchy-live-wallpaper-menu-end/d' "$MENU_EXT"
sed -i '/"style\.background":/d' "$MENU_EXT"

MENU_BLOCK='  // omarchy-live-wallpaper-menu-start
  "style.background": {"icon":"","label":"Background","aliases":["background","wallpaper"],"when":"[ -x \"'$PLUGIN_DIR'/bin/omarchy-bg-switcher\" ]","action":"background=\"$('"$PLUGIN_DIR"'/bin/omarchy-bg-switcher)\"; [[ -n $background ]] && \"'$PLUGIN_DIR'/bin/omarchy-bg-set\" \"$background\""}
  // omarchy-live-wallpaper-menu-end'

python3 - "$MENU_EXT" "$MENU_BLOCK" <<'PY'
import sys

path, block = sys.argv[1], sys.argv[2]
with open(path) as f:
    content = f.read()

stripped = content.rstrip()
idx = stripped.rfind('}')
if idx == -1:
    sys.exit(f"no closing brace in {path}")

before = stripped[:idx].rstrip()
after = stripped[idx:].lstrip('\n')
with open(path, "w") as f:
    f.write(before + "\n" + block + "\n" + after)
PY

# ----------------------------------------- stale theme-set hook cleanup

# Older generations installed a theme-set hook to restart the video after a
# theme change. The video now runs on the bottom layer above the theme
# wallpaper, so theme changes can't touch it and the hook is obsolete.
if [[ -f $HOOK_PATH ]]; then
  rm -f -- "$HOOK_PATH"
fi

printf '%s\n' "$INSTALLED_V2" > "$INSTALLED_FILE"

echo "taxin.live-wallpaper: integration installed (menu row; theme hook retired)"
