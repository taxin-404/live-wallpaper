#!/usr/bin/env bash
# omarchy-live-uninstall — full manual cleanup for the taxin.live-wallpaper
# plugin. Normally `omarchy plugin remove taxin.live-wallpaper` is enough (the
# menu row auto-hides and the theme hook self-deletes); this removes the
# remaining state, cache, and generated config for a spotless wipe.
set -euo pipefail

PLUGIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/live-wallpaper"
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/omarchy/live"
POSTER_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/omarchy/live-posters"
MENU_EXT="$HOME/.config/omarchy/extensions/omarchy-menu.jsonc"
HOOK_PATH="$HOME/.config/omarchy/hooks/theme-set.d/10-live-wallpaper.sh"

# Remove the marked menu block (only if it's still ours).
if [[ -f $MENU_EXT ]]; then
  sed -i '/\/\/ omarchy-live-wallpaper-menu-start/,/\/\/ omarchy-live-wallpaper-menu-end/d' "$MENU_EXT"
  sed -i '/"style\.background":/d' "$MENU_EXT"
fi

# Remove the theme hook only if generated by us.
if [[ -f $HOOK_PATH ]] && grep -q "generated by omarchy-live-install" "$HOOK_PATH"; then
  rm -f "$HOOK_PATH"
fi

# Stop any running live wallpaper.
"$PLUGIN_DIR/bin/omarchy-live-wallpaper" stop >/dev/null 2>&1 || true

# State, cache, and old ~/.local/bin symlinks from the pre-plugin install.sh.
rm -rf "$STATE_DIR" "$CACHE_DIR" "$POSTER_DIR"
rm -f \
  "$HOME/.local/bin/omarchy-live-wallpaper" \
  "$HOME/.local/bin/omarchy-bg-switcher" \
  "$HOME/.local/bin/omarchy-bg-set"

echo "taxin.live-wallpaper: cleaned."