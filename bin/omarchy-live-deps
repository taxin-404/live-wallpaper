#!/usr/bin/env bash
# omarchy-live-deps — ensure the plugin's system dependencies are installed.
#
# Requires: mpvpaper (AUR, the video renderer), ffmpeg (video poster
# thumbnails), jq (layer detection), socat (mpv IPC to swap videos in place).
# If any are missing, opens a floating terminal that installs them so the user
# can type their sudo password, then waits for the install to finish. Exits 0
# once everything is present.
set -euo pipefail

REQUIRED=(mpvpaper ffmpeg jq socat)
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/live-wallpaper"

# Serialize concurrent callers (installer on load + set/restore) so a missing
# dependency only ever opens one install terminal; the others wait their turn.
mkdir -p "$STATE_DIR"
exec 9>"$STATE_DIR/.deps.lock"
flock 9

missing() {
  local c
  for c in "${REQUIRED[@]}"; do
    command -v "$c" >/dev/null 2>&1 || echo "$c"
  done
}

need=()
while IFS= read -r c; do
  [[ -n $c ]] && need+=("$c")
done < <(missing)

if (( ${#need[@]} == 0 )); then
  exit 0
fi

echo "live wallpaper needs missing packages: ${need[*]}" >&2
if ! command -v omarchy-launch-floating-terminal-with-presentation >/dev/null 2>&1; then
  echo "Run: yay -S ${need[*]}" >&2
  exit 1
fi

omarchy-launch-floating-terminal-with-presentation "yay -S --noconfirm ${need[*]}" >/dev/null 2>&1 || true

for _ in {1..600}; do
  (( $(missing | wc -l) == 0 )) && exit 0
  sleep 1
done

echo "Packages still missing. Run: yay -S ${need[*]}" >&2
exit 1
