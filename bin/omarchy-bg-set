#!/usr/bin/env bash
# omarchy-bg-set — apply a picker selection: a live poster starts a video
# wallpaper; anything else is treated as a static image.
set -euo pipefail

path="${1:-}"
[[ -n $path ]] || { echo "usage: omarchy-bg-set <selected-path>" >&2; exit 1; }

BIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LIVE_CLI="$BIN_DIR/omarchy-live-wallpaper"

POSTER_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/omarchy/live-posters"
INDEX_FILE="$POSTER_DIR/index"
video=""

if [[ -f $INDEX_FILE ]]; then
  video=$(awk -F '\t' -v p="$path" '$1 == p { print $2; exit }' "$INDEX_FILE")
fi

if [[ -n $video && -f $video ]]; then
  "$LIVE_CLI" set "$video"
else
  # Set the static background first, while the video still covers it, then
  # stop the renderer: if the set fails the live wallpaper keeps playing, and
  # the reveal happens underneath it so there is never a bare gap.
  ext="${path##*.}"
  case "${ext,,}" in
    # Absolute path to the real built-in: the omarchy-theme-bg-set name is
    # shadowed by a user-space shim (installed for the wallpaper double-click),
    # and this static branch must not loop back into it.
    jpg|jpeg|png|webp|gif|bmp)
      /usr/bin/omarchy-theme-bg-set "$path" && "$LIVE_CLI" stop ;;
    *) echo "not an image: $path" >&2; exit 1 ;;
  esac
fi